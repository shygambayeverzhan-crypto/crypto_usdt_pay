# Copy to .env and fill in your own values. Never commit .env.
# Empty values must be configured before the corresponding feature is used.
APP_NAME=""
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=
APP_LOCALE=ru
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

# Initial administrator; consumed only by php artisan app:install.
# Remove ADMIN_PASSWORD after creating your administrator.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# Database: set your own server, database and credentials.
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_SOCKET=

# Sessions, queue and cache server.
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis
REDIS_CLIENT=phpredis
REDIS_HOST=
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
MEMCACHED_HOST=
MEMCACHED_USERNAME=
MEMCACHED_PASSWORD=

# Email is disabled (log only) until configured.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# Optional object storage and email/API providers.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false
POSTMARK_TOKEN=
RESEND_KEY=
SLACK_BOT_USER_OAUTH_TOKEN=
SLACK_BOT_USER_DEFAULT_CHANNEL=
SQS_PREFIX=

VITE_APP_NAME="${APP_NAME}"
INERTIA_SSR_ENABLED=false
INERTIA_SSR_URL=

# Choose a network and configure its API endpoint and token contract.
# The token contract is NOT your receiving wallet address.
TRONGRID_NETWORK=nile
TRONGRID_BASE_URL=
TRONGRID_API_KEY=
TRONGRID_USDT_CONTRACT=
TRONGRID_TESTNET_BASE_URL=
TRONGRID_TESTNET_USDT_CONTRACT=
TRONSCAN_BASE_URL=
TRONSCAN_TESTNET_BASE_URL=
PUBLIC_API_KEY=

# Optional geolocation.
IPGEOLOCATION_BASE_URL=
IPGEOLOCATION_API_KEY=

# Your Telegram bot. Leave empty until the bot is configured.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_NAME=
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_CERTIFICATE_PATH=

# Optional sandbox sender only; separate wallet-signer/.env is required.
SANDBOX_WALLET_ID=
SANDBOX_WALLET_NETWORK=nile
